# Generate an owner password hash with: uv run python scripts/create_owner.py
OWNER_USERNAME=admin
OWNER_PASSWORD_HASH=
APP_ORIGIN=http://localhost:8000
BASE_PATH=
DATA_DIR=runtime
# Optional. Without a key, guided local hints and simulations remain usable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional OpenAI-compatible endpoint on your private local-machine connection.
# Configure it on the server; the browser cannot choose a destination URL.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
# Shared web/worker hard limits; reserve the worst-case amount BEFORE a call.
AI_DAILY_CALL_LIMIT=40
AI_DAILY_USD_LIMIT=2
AI_CALL_USD_LIMIT=0.05
RESEARCH_INTERVAL_SECONDS=21600


# Optional private source libraries; do not place tokens in source control.
LIBRARY_API_URL=
LIBRARY_API_TOKEN=
LIBRARY_WEB_URL=
LIBRARY_LABEL=Source library
LIBRARY_SECONDARY_API_URL=
LIBRARY_SECONDARY_API_TOKEN=
WORKSPACE_URL=
HOST_URL=

# Optional host-managed sources. When set, direct library adapters are bypassed.
HOST_SOURCE_URL=
HOST_SOURCE_TOKEN=
HOST_NAME=
HOST_HOME_PATH=/
HOST_SETTINGS_PATH=
HOST_FONT_URL=
